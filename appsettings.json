{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Urls": "http://localhost:5080",
  "Ui": {
    "IntroPhrase": "Everything said in this room is heard once, written down for a moment, and then let go. Nothing here is saved."
  },
  "Filter": {
    "Enabled": true,
    "WordsFile": "forbidden-words.txt"
  },
  "Whisper": {
    "Model": "base.en",
    "ModelsDir": "models",
    "Language": "en",
    "Threads": 4,
    "RetentionSeconds": 30,
    "StepMs": 1500,
    "MaxSegmentMs": 10000,
    "SilenceMs": 700,
    "SilenceRms": 0.01
  }
}
